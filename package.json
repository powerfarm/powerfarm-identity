{
  "name": "powerfarm-registry",
  "private": true,
  "workspaces": [
    "brand",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "identity:dev": "npm run brand:build && npm run dev --workspace @powerfarm/identity-host",
    "identity:build": "npm run brand:build && npm run build --workspace @powerfarm/identity-host",
    "brand:build": "node scripts/build-brand.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "brand:lock": "node scripts/build-brand.mjs --write-lock",
    "prebuild": "npm run brand:build",
    "build": "next build",
    "start": "next start",
    "migrations:check": "node scripts/check-migration-parity.mjs",
    "contracts:check": "node scripts/check-contract-parity.mjs",
    "test": "node --test tests/*.test.mjs && npm run migrations:check && npm run contracts:check && npm run brand:check"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^5.9.3"
  }
}
